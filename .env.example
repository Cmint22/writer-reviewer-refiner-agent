# Copy this file to .env and fill in your own values.
# Never commit a real .env file with a real API key.

# --- LLM connection (any OpenAI-compatible /v1/chat/completions endpoint) ---
# Required: the app has no offline/mock mode, so a valid key is mandatory.
LLM_API_KEY=

# Defaults to OpenRouter's free Liquid model. Point this at any
# OpenAI-compatible provider instead (OpenAI, Azure OpenAI, Groq, Together AI,
# a local server, etc.) by changing these two values.
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=liquid/lfm-2.5-2.6b:free
LLM_TEMPERATURE=0.2
LLM_REQUEST_TIMEOUT=60

# --- FastAPI server ---
APP_HOST=0.0.0.0
APP_PORT=8000
